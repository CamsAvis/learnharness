# systemd user service: Cloudflare tunnel for learn.itsnotcam.dev.
# Installed by release.sh; enabled once the tunnel token exists.
#
# The tunnel's routing (learn.itsnotcam.dev -> http://127.0.0.1:3005) lives in
# Cloudflare, and Cloudflare Access requires an email one-time code before any
# request reaches the app. The token file holds one line, TUNNEL_TOKEN=...,
# readable only by this user.
[Unit]
Description=Cloudflare tunnel for learn.itsnotcam.dev
After=network-online.target learnharness.service

[Service]
Type=simple
EnvironmentFile=%h/.config/cloudflared/learnharness.env
ExecStart=/usr/bin/cloudflared --no-autoupdate tunnel run
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
